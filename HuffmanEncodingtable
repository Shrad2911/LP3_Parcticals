import heapq

class Node:
    def __init__(self, char, freq):
        self.char = char
        self.freq = freq
        self.left = None
        self.right = None

    def __lt__(self, other):
        return self.freq < other.freq

def generate_huffman_codes(char_freqs):
    heap = [Node(char, freq) for char, freq in char_freqs.items()]
    heapq.heapify(heap)

    while len(heap) > 1:
        left = heapq.heappop(heap)
        right = heapq.heappop(heap)
        merged = Node(None, left.freq + right.freq)
        merged.left = left
        merged.right = right
        heapq.heappush(heap, merged)

    root = heap[0] if heap else None
    huffman_codes = {}
    
    def traverse_tree(node, current_code):
        if node is None:
            return
        if node.char is not None:
            huffman_codes[node.char] = current_code
            return
        traverse_tree(node.left, current_code + "0")
        traverse_tree(node.right, current_code + "1")

    traverse_tree(root, "")
    return huffman_codes

if __name__ == "__main__":
    input_table = {'a': 5, 'b': 9, 'c': 12, 'd': 13, 'e': 16, 'f': 45}
    codes = generate_huffman_codes(input_table)
    
    print(f"{'Character':<10} | {'Frequency':<10} | {'Binary Code':<12}")
    print("-" * 40)
